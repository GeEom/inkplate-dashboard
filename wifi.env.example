# Copy to wifi.env (gitignored) and fill in. scripts/flash_and_monitor.py
# compiles these into the firmware, so never commit the real file, and never
# publish a build made from it.

# The 2.4GHz WPA2 network the display joins.
INKPLATE_WIFI_SSID=
INKPLATE_WIFI_PASS=

# The image to show: https://host/path, no port. The firmware adds width,
# height, tones and wait to the query (see README).
INKPLATE_SERVER_URL=

# Sent as Authorization: Bearer, if set.
INKPLATE_SERVER_TOKEN=

# Optional:
# INKPLATE_BOARD=5                       first-generation Inkplate 5 (default 5v2)
# INKPLATE_TEST_PATTERN=1                or grey: a bring-up pattern, then halt

# The host suite's live checks against Makespace's members-app
# (scripts/host_tls_test.sh); not compiled in.
# TEST_MAKESPACE_TOKEN=
